        "python": "import sys\nimport json\ndef permute(nums):\n    res = []\n    def backtrack(start):\n        if start == len(nums): res.append(list(nums)); return\n        for i in range(start, len(nums)):\n            nums[start], nums[i] = nums[i], nums[start]\n            backtrack(start + 1)\n            nums[start], nums[i] = nums[i], nums[start]\n    backtrack(0); return res\nif __name__ == '__main__':\n    line = sys.stdin.read().strip()\n    if line: print(json.dumps(permute(eval(line.replace(' ', ',')))))",
