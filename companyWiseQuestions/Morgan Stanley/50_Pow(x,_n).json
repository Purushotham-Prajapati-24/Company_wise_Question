    "boilerplate": {
        "python": "import sys\ndef myPow(x, n):\n    if n < 0: x = 1/x; n = -n\n    res = 1\n    while n: \n        if n % 2: res *= x\n        x *= x; n //= 2\n    return res\nif __name__ == '__main__':\n    lines = sys.stdin.read().strip().split()\n    if len(lines) >= 2: print(\"{:.5f}\".format(myPow(float(lines[0]), int(lines[1]))))",
