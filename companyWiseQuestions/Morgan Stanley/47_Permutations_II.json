    "boilerplate": {
        "python": "import sys\nimport json\ndef permuteUnique(nums):\n    nums.sort(); res, used = [], [False] * len(nums)\n    def backtrack(combo):\n        if len(combo) == len(nums): res.append(list(combo)); return\n        for i in range(len(nums)):\n            if used[i] or (i > 0 and nums[i] == nums[i-1] and not used[i-1]): continue\n            used[i] = True; combo.append(nums[i]); backtrack(combo); combo.pop(); used[i] = False\n    backtrack([]); return res\nif __name__ == '__main__':\n    line = sys.stdin.read().strip()\n    if line: print(json.dumps(permuteUnique(eval(line.replace(' ', ',')))))",
