    "boilerplate": {
        "python": "import sys\nimport json\ndef rotate(matrix):\n    n = len(matrix)\n    for i in range(n // 2 + n % 2): \n        for j in range(n // 2):\n            tmp = matrix[n-1-j][i]\n            matrix[n-1-j][i] = matrix[n-1-i][n-1-j]\n            matrix[n-1-i][n-1-j] = matrix[j][n-1-i]\n            matrix[j][n-1-i] = matrix[i][j]\n            matrix[i][j] = tmp\nif __name__ == '__main__':\n    line = sys.stdin.read().strip()\n    if line:\n        matrix = eval(line.replace(' ', ','))\n        rotate(matrix); print(json.dumps(matrix))",
