{
    "question_text": "<h3>28. Find the Index of the First Occurrence in a String</h3><p>Given two strings <code>needle</code> and <code>haystack</code>, return the index of the first occurrence of <code>needle</code> in <code>haystack</code>, or <code>-1</code> if <code>needle</code> is not part of <code>haystack</code>.</p>",
    "difficulty": "EASY",
    "marks": 5,
    "input_format": "Two lines: the first line contains `haystack`, the second contains `needle`.",
    "output_format": "Return the integer index of the first occurrence of needle in haystack, or -1.",
    "constraints": [
        "1 <= haystack.length, needle.length <= 10^4",
        "haystack and needle consist of only lowercase English characters."
    ],
    "explanation": "Use Python's built-in `str.find()` or implement KMP (Knuth-Morris-Pratt) for O(N+M) matching. The naive O(N*M) approach also works within constraints.",
    "answer": "def strStr(haystack, needle):\n    return haystack.find(needle)",
    "boilerplate": {
        "python": "import sys\nimport json\n\ndef solve(haystack, needle):\n    return haystack.find(needle)\n\nif __name__ == '__main__':\n    content = sys.stdin.read().strip().split('\\n')\n    if len(content) >= 2:\n        haystack = json.loads(content[0])\n        needle = json.loads(content[1])\n        print(json.dumps(solve(haystack, needle)))",
        "cpp": "#include <iostream>\n#include <string>\nusing namespace std;\n\nint strStr(string haystack, string needle) {\n    size_t pos = haystack.find(needle);\n    return pos == string::npos ? -1 : (int)pos;\n}\n\nint main() {\n    string haystack, needle;\n    if (getline(cin, haystack) && getline(cin, needle)) {\n        if (haystack.front() == '\"') haystack = haystack.substr(1, haystack.size() - 2);\n        if (needle.front() == '\"') needle = needle.substr(1, needle.size() - 2);\n        cout << strStr(haystack, needle) << endl;\n    }\n    return 0;\n}",
        "java": "import java.util.*;\nimport java.io.*;\n\npublic class Main {\n    public static int strStr(String haystack, String needle) {\n        return haystack.indexOf(needle);\n    }\n\n    public static void main(String[] args) throws IOException {\n        BufferedReader br = new BufferedReader(new InputStreamReader(System.in));\n        String haystack = br.readLine();\n        String needle = br.readLine();\n        if (haystack != null && needle != null) {\n            haystack = haystack.replaceAll(\"^\\\"\", \"\").replaceAll(\"\\\"$\", \"\");\n            needle = needle.replaceAll(\"^\\\"\", \"\").replaceAll(\"\\\"$\", \"\");\n            System.out.println(strStr(haystack, needle));\n        }\n    }\n}",
        "javascript": "const fs = require('fs');\n\nfunction strStr(haystack, needle) {\n    return haystack.indexOf(needle);\n}\n\nconst input = fs.readFileSync(0, 'utf8').trim().split('\\n');\nif (input.length >= 2) {\n    const haystack = JSON.parse(input[0]);\n    const needle = JSON.parse(input[1]);\n    console.log(JSON.stringify(strStr(haystack, needle)));\n}",
        "c": "#include <stdio.h>\n#include <string.h>\n\nint strStr(const char* haystack, const char* needle) {\n    char* pos = strstr(haystack, needle);\n    return pos == NULL ? -1 : (int)(pos - haystack);\n}\n\nint main() {\n    char haystack[10010], needle[10010];\n    if (fgets(haystack, sizeof(haystack), stdin) && fgets(needle, sizeof(needle), stdin)) {\n        int hl = strlen(haystack);\n        while (hl > 0 && (haystack[hl-1] == '\\n' || haystack[hl-1] == '\"')) hl--;\n        haystack[hl] = 0;\n        char* hs = haystack;\n        if (*hs == '\"') hs++;\n        int nl = strlen(needle);\n        while (nl > 0 && (needle[nl-1] == '\\n' || needle[nl-1] == '\"')) nl--;\n        needle[nl] = 0;\n        char* nd = needle;\n        if (*nd == '\"') nd++;\n        printf(\"%d\\n\", strStr(hs, nd));\n    }\n    return 0;\n}"
