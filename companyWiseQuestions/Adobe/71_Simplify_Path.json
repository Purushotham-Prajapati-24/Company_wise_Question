    "explanation": "Optimized approach for Simplify Path",
    "answer": "class Solution:\n    def simplifyPath(self, path: str) -> str:\n        stack = []\n        for p in path.split('/'):\n            if p == \"..\":\n                if stack: stack.pop()\n            elif p and p != \".\":\n                stack.append(p)\n        return \"/\" + \"/\".join(stack)",
    "boilerplate": {
        "python": "import sys, json\n\ndef simplifyPath(path):\n    stack = []\n    for p in path.split('/'):\n        if p == \"..\":\n            if stack: stack.pop()\n        elif p and p != \".\":\n            stack.append(p)\n    return \"/\" + \"/\".join(stack)\n\nif __name__ == '__main__':\n    data = sys.stdin.read().strip()\n    if data:\n        path = json.loads(data)\n        print(json.dumps(simplifyPath(path)))",
        "cpp": "#include <iostream>\n#include <vector>\n#include <string>\n#include <sstream>\nusing namespace std;\n\nstring simplifyPath(string path) {\n    vector<string> stack;\n    stringstream ss(path);\n    string part;\n    while (getline(ss, part, '/')) {\n        if (part == \"\" || part == \".\") continue;\n        if (part == \"..\") {\n            if (!stack.empty()) stack.pop_back();\n        } else {\n            stack.push_back(part);\n        }\n    }\n    string res = \"\";\n    for (string s : stack) res += \"/\" + s;\n    return res.empty() ? \"/\" : res;\n}\n\nint main() {\n    string path;\n    if (cin >> path) {\n        if (path.front() == '\"') path = path.substr(1, path.length() - 2);\n        cout << \"\\\"\" << simplifyPath(path) << \"\\\"\" << endl;\n    }\n    return 0;\n}",
        "java": "import java.util.*;\n\npublic class Main {\n    public static String simplifyPath(String path) {\n        Stack<String> stack = new Stack<>();\n        String[] parts = path.split(\"/\");\n        for (String p : parts) {\n            if (p.equals(\"..\")) {\n                if (!stack.isEmpty()) stack.pop();\n            } else if (!p.isEmpty() && !p.equals(\".\")) {\n                stack.push(p);\n            }\n        }\n        return \"/\" + String.join(\"/\", stack);\n    }\n\n    public static void main(String[] args) {\n        Scanner sc = new Scanner(System.in);\n        if (sc.hasNext()) {\n            String path = sc.next();\n            if (path.startsWith(\"\\\"\")) path = path.substring(1, path.length() - 1);\n            System.out.println(\"\\\"\" + simplifyPath(path) + \"\\\"\");\n        }\n    }\n}",
        "javascript": "const fs = require('fs');\n\nfunction simplifyPath(path) {\n    let stack = [];\n    let parts = path.split('/');\n    for (let p of parts) {\n        if (p === '..') {\n            if (stack.length > 0) stack.pop();\n        } else if (p !== '' && p !== '.') {\n            stack.push(p);\n        }\n    }\n    return '/' + stack.join('/');\n}\n\nconst input = fs.readFileSync(0, 'utf8').trim();\nif (input) {\n    const path = JSON.parse(input);\n    console.log(JSON.stringify(simplifyPath(path)));\n}",
