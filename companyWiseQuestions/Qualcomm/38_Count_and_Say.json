    "answer": "class Solution:\\n    def countAndSay(self, n: int) -> str:\\n        res = '1'\\n        for _ in range(n - 1):\\n            next_res, i = '', 0\\n            while i < len(res):\\n                count = 1\\n                while i + 1 < len(res) and res[i] == res[i+1]:\\n                    i += 1\\n                    count += 1\\n                next_res += str(count) + res[i]\\n                i += 1\\n            res = next_res\\n        return res",
    "boilerplate": {
        "python": "import sys\n\ndef countAndSay(n):\n    if n == 1: return \"1\"\n    res = \"1\"\n    for _ in range(n-1):\n        next_res = \"\"\n        i = 0\n        while i < len(res):\n            count = 1\n            while i + 1 < len(res) and res[i] == res[i+1]:\n                i += 1\n                count += 1\n            next_res += str(count) + res[i]\n            i += 1\n        res = next_res\n    return res\n\nif __name__ == '__main__':\n    line = sys.stdin.read().strip()\n    if line:\n        print(f'\"{countAndSay(int(line))}\"')\n",
        "cpp": "#include <iostream>\n#include <string>\n#include <vector>\nusing namespace std;\n\nstring countAndSay(int n) {\n    if (n == 1) return \"1\";\n    string res = \"1\";\n    for (int i = 1; i < n; i++) {\n        string next_res = \"\";\n        for (int j = 0; j < res.length(); j++) {\n            int count = 1;\n            while (j + 1 < res.length() && res[j] == res[j+1]) {\n                j++;\n                count++;\n            }\n            next_res += to_string(count) + res[j];\n        }\n        res = next_res;\n    }\n    return res;\n}\n\nint main() {\n    int n;\n    if (cin >> n) {\n        cout << \"\\\"\" << countAndSay(n) << \"\\\"\" << endl;\n    }\n    return 0;\n}\n",
        "java": "import java.util.*;\nimport java.io.*;\n\npublic class Main {\n    public static String countAndSay(int n) {\n        if (n == 1) return \"1\";\n        String s = \"1\";\n        for (int i = 1; i < n; i++) {\n            StringBuilder sb = new StringBuilder();\n            for (int j = 0; j < s.length(); j++) {\n                int count = 1;\n                while (j + 1 < s.length() && s.charAt(j) == s.charAt(j + 1)) {\n                    j++;\n                    count++;\n                }\n                sb.append(count).append(s.charAt(j));\n            }\n            s = sb.toString();\n        }\n        return s;\n    }\n\n    public static void main(String[] args) throws IOException {\n        Scanner sc = new Scanner(System.in);\n        if (sc.hasNextInt()) {\n            System.out.println(\"\\\"\" + countAndSay(sc.nextInt()) + \"\\\"\");\n        }\n    }\n}\n",
